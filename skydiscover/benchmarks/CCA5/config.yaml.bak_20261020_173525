# ─── evaluator：评测器 ──────────────────────────────────────────────────────

evaluator:
  # 单次评测子进程的超时（秒），默认 360。
  # 需覆盖 cargo build --release + 基线（bbr/cubic/copa，分数按 trace 对基线归一化）
  # + llmgen 跑完所有 trace。
  timeout: 1800
  # 评测失败重试次数。重建重跑很贵，失败大概率是真失败，故取 1。
  max_retries: 1
  # 级联评测：低分程序跳过完整评测以省时间。
  # CCA 必须整包跑完才知道分数，无法分批省钱。
  cascade_evaluation: false

  # 是否把 evaluator 源码塞进系统提示，让模型看到打分逻辑。
  # null = 自动（有种子程序时关闭）。此处已在 system_message 手工写明规则，不写即保持自动。
  # inject_evaluator_context: null
  # 额外用一个 LLM 打分，暂不使用。
  # llm_as_judge: false

monitor:
  enabled: true

# ─── search：搜索策略 ──────────────────────────────────────────────────────

search:
  type: "adaevolve"
  #搜寻机制
  # topk,beam_search,best_of_n,adaevolve,evox,openevolve,gepa,shinkaevolve,alphaevolve

  num_context_programs: 4
  #每次让 LLM 生成新候选算法时，额外提供 4 个已有程序作为参考上下文。

  #种群设置
  database:
    population_size: 20 #每个 island 最多 30 个候选
    num_islands: 2  

    # --- 自适应搜索强度 ---
    # 控制搜索强度如何根据改进信号（G）自适应调整
    # 高 G（高产岛屿）-> 低强度（利用/exploit）
    # 低 G（停滞岛屿）-> 高强度（探索/explore）
    decay: 0.9                        # 更新 G 时保留 90% 的历史信号，加入 10% 的本次改进信号
    intensity_min: 0.15               # G高时仍有15%的概率进行探索（exploration）  
    intensity_max: 0.5                # G低时有50%的概率进行探索（exploration）

    # --- 消融开关 ---
    # 设为 false 可禁用特定自适应机制，用于消融实验
    # 是否让每个小组根据最近表现自动调整探索程度
    use_adaptive_search: true         # 基于 G 的强度 vs fixed_intensity
    # 决定每轮选择哪个 island 工作
    use_ucb_selection: true           # UCB 岛屿选择 vs 轮询（round-robin）
    use_migration: true               # 岛屿间迁移
    # 决定每个 island 如何保存候选程序
    use_unified_archive: true         # 质量-多样性归档 vs 简单列表
    # fixed_intensity: 0.4            # 当 use_adaptive_search=false 时使用
    
    # --- 迁移 ---
    migration_interval: 15            # 每 N 次迭代迁移一次
    migration_count: 5                # 迁移的 top 程序数量

    # --- 归档设置（当 use_unified_archive=true 时）---
    fitness_weight: 0.7               # 精英评分中适应度排名的权重
    novelty_weight: 0.3              # 精英评分中新颖性排名的权重
    diversity_strategy: "code"        # 多样性度量："code"、"metric" 或 "hybrid"

    # --- 可选的 Pareto 多目标模式 ---
    # 将 pareto_objectives 留空以保持当前标量 combined_score 行为。
    # 启用时，从评估器返回原始目标指标并设置：
    # pareto_objectives:
    #   - accuracy
    #   - latency
    # higher_is_better:
    #   accuracy: true
    #   latency: false
    # fitness_key: accuracy              # 可选：用于自适应状态/平局打破的标量代理
    # pareto_objectives_weight: 0.4      # Pareto 百分位在归档精英评分中的权重

    # --- 动态岛屿生成 ---
    use_dynamic_islands: true
    max_islands: 5                    # 最大岛屿数量
    spawn_productivity_threshold: 0.20   # 若全局生产力低于此值则生成新岛屿。
                                         # 注意该 productivity 是「累计改进 / 累计评测」的全程
                                         # 平均值（分母只统计被存档接收的程序），会收敛到平台值
                                         # 而非衰减到 0。实测平台值随 run 而异（0.03~0.20），
                                         # 原值 0.015 在所有 run 中都永不触发。
    spawn_cooldown_iterations: 20     # 两次生成之间等待 N 次迭代

    # --- 范式突破 ---
    use_paradigm_breakthrough: true
    paradigm_window_size: 10          # 用于计算改进率的窗口大小
    paradigm_improvement_threshold: 0.12  # 停滞阈值
    paradigm_max_uses: 2              # 每个范式最大使用次数
    paradigm_max_tried: 10            # 最多跟踪的已尝试范式数量
    paradigm_num_to_generate: 3       # 每次触发时生成的范式数量

    # --- 错误重试 ---
    enable_error_retry: true
    max_error_retries: 2
# ─── prompt：系统提示（整个配置最重要的部分）────────────────────────────────

prompt:
  # 会被拼进每次生成请求的系统提示。
  # 注意：若写成一行且短于 256 字符，会被当成「相对本 config 的文件名」去读取；
  # 用 |- 写成多行块则按字面量处理。也可写成 "system_prompt.txt" 外置成文件。
  system_message: |-
    You are a Senior Networking Architect optimizing a custom QUIC congestion control
    algorithm in Rust (the `LLMGen` module) to beat BBR, CUBIC and Copa on real
    network traces. You are MUTATING a working, compiling controller -- not writing
    a new design from scratch.

    SCORING -- the score is a trace-normalized utility, NOT raw Mbps:
    - Each trace's single-flow metrics are normalized against the best non-llmgen
      baseline (bbr/cubic/copa) on that same trace.
    - STREAM utility rewards normalized throughput, capped above the best baseline so
      queue-building aggression is not rewarded indefinitely. Queueing delay
      (srtt - min_rtt) and jitter (rttvar) are penalized, normalized by min_rtt.
    - RPC utility rewards aggregate request-workload progress relative to the best
      baseline and strongly penalizes queueing delay/jitter. The current harness does
      not expose per-request tail latency, so do not claim p95/p99 RPC latency from
      this score alone.
    - VIDEO utility uses target-rate style throughput saturation: reaching the target
      bitrate is rewarded (you can estimate the target bitrate based on baseline
      statistics), but excess throughput does not compensate for queueing delay or
      jitter.
    - final score = application utility - fairness penalty - convergence penalty.

    FAIRNESS (two concurrent QUIC flows on one bottleneck):
    - Target Jain index >= 0.95 and a 40%-60% long-run throughput share.
    - High single-flow throughput with Jain 0.5-0.8 counts as a FAILURE.
    - Use local signals only: sustained queueing delay, rate plateau, losses with
      elevated queueing delay, bytes_in_flight near cwnd.

    CONVERGENCE:
    - Reach 90% of steady-state throughput and hold it for 3 consecutive samples.
    - Slow convergence is penalized in proportion to convergence_time / duration.

    API FACTS:
    1. CongestionStats: maintain bytes_sent_in_total, bytes_acked_in_total,
       bytes_lost_in_total, bytes_in_flight in the right callbacks.
    2. RttEstimator: smoothed_rtt(), latest_rtt(), min_rtt() return Duration.
    3. SentPacket: use `sent_size as u64` for accounting.
    4. RecoveryConfig: max_datagram_size: usize, initial_congestion_window: u64.

    NETWORK SCENARIOS -- the evaluator runs one of these; apply the matching guidance:
    - Cellular links have rapidly changing bandwidth, deep buffers, and random radio
      loss. Do not cut cwnd on isolated loss when queueing delay stays low. Prefer
      mechanisms that can re-expand quickly after non-congestion loss.
    - LEO satellite links have high BDP and occasional handover loss. Distinguish
      persistent queue growth from brief handover events. Avoid overreacting to short
      disruption spikes that are not backed by sustained delay.
    - WAN paths are comparatively stable but still see occasional random drops. Use
      delay trend, delivery-rate trend, and inflight pressure together instead of loss
      alone. Keep probing bounded so long-lived standing queues do not dominate the
      path.

    HARD CONSTRAINTS:
    1. Keep self.cwnd >= self.minimal_window() after any reduction.
    2. On persistent congestion, cut back to the minimum window.
    3. Use saturating arithmetic where overflow/underflow is possible. There is no
       saturating_div.
    4. Pacing must not use integer-second time truncation. Use as_secs_f64() or exact
       microsecond math and return bytes per second.
    5. Use only local sender-observable signals. No oracle knowledge of bandwidth or
       the other flow.
    6. Do not change the public interface: the struct stays `LLMGen`, implements
       `CongestionController`, and keeps `LLMGenConfig::from(&RecoveryConfig)` usable.
       The file is compiled as tquic/src/congestion_control/llmgen.rs.

    DESIGN GUIDANCE:
    - Diagnose whether the parent fails from underutilization, queue overshoot, weak
      loss classification, poor pacing, unstable probing, unfair coexistence, or slow
      convergence.
    - Valid directions: delay-targeted control, delivery-rate trend control,
      target-inflight control, bounded probing, epoch utility control, or a coherent
      hybrid. Do not mechanically imitate BBR, Copa or CUBIC.
    - If fairness is poor, add an explicit coexistence brake reacting to sustained
      queue pressure, plateaued delivery rate, or repeated congestion-marking loss.

    MUTATION SCOPE -- let the evidence decide how large your edit is, not habit:
    - Fine-tune only (2 to 4 localized changes) when BOTH hold:
        (1) the parent is already competitive: its combined_score is at or above the
            best baseline score on the same traces (see the baseline_* metrics), and
        (2) the diagnosis points to tuning-level problems -- thresholds, gains,
            backoff strength, pacing constants, loss-classification conditions,
            startup exit logic -- rather than a wrong control law.
      Preserve the parent's measured strengths; repair only the specific failure the
      metrics point at.
    - Guided redesign (replacing the main control law) is allowed when the parent is
      clearly behind the baselines, or the diagnosis shows the primary mechanism
      itself is broken: persistent underutilization, runaway queueing delay, fairness
      collapse, or failure to converge.
    - Either way, do not rewrite startup, steady-state control and recovery all at
      once: one change set should be attributable to one failure mode.

    EDITING RULES:
    - Keep the `// EVOLVE-BLOCK-START` and `// EVOLVE-BLOCK-END` comments intact.
    - The result must compile with `cargo build --release`. Uncompilable code scores 0.
    - Use `///` doc comments, not Python docstrings.

  # 程序字符数超过该值后，提示词会开始引导模型「简化」。
  # 默认 500 过于激进。种子 25940 B，阈值设 30000：平时不触发，只有模型把
  # 文件堆到明显臃肿时才出来提醒，免得它把精力花在删代码上。
  suggest_simplification_after_chars: 30000