# =============================================================================
# CCA5 — QUIC 拥塞控制算法进化（tquic + mahimahi 真实 trace）
# =============================================================================

# 进化语言
language: rust

# 候选文件扩展名。
file_suffix: ".rs"

# true = 让 LLM 输出 <<<<<<< SEARCH / ======= / >>>>>>> REPLACE 补丁，而非整个文件。
# 省 token、改动局部化、不易改坏无关代码。该格式与语言无关，Rust 同样适用。
diff_based_generation: true

# 进化总轮数。CCA 一次评测要 cargo build + 跑基线 + 跑 trace（几到十几分钟），
max_iterations: 150

# 每 N 轮存一次断点，进程中断后可续跑。评测昂贵，间隔取小。
checkpoint_interval: 2

# 候选程序字符上限。注意这是「拒绝」阈值，不是「截断」：超了直接判
# parse_error、子代作废重试（default_discovery_controller.py:576）。
# 而且 diff_based_generation 下子代 = 父本全文 + 补丁，体积约等于父本，
# 所以这个值必须明显大于种子。种子 25940 B，给 1.7 倍、留约 19KB 生长余量。
max_solution_length: 45000

# ─── llm：模型端点（教研室本地服务，保持不变）───────────────────────────────

llm:
  # 采样温度。默认 0.7 偏高，代码进化容易产出编译不过的代码；
  # 现有 mutate_algorithm.py 用的是 0.2，这里 0.4 兼顾探索与稳定。
  temperature: 0.4
  # 单次回复 token 上限。
  max_tokens: 32000
  # 单次 LLM 请求超时（秒）。
  timeout: 600
  # 请求失败的重试次数与重试间隔（秒）。
  retries: 3
  retry_delay: 5

  # # 候选生成用的模型池，按 weight 加权随机抽样。
  models:
    - name: "mimo-v2.6-flash"
      weight: 1.0
      api_base: "http://192.168.1.19:4000/v1"
      api_key: "sk-tfpyrUy-WvfGKpYcAP1a9w"
      stream: true
      reasoning_effort: "high"
      max_tokens: 131072

  # models:
  #   - name: "deepseek-v4-flash"
  #     weight: 1.0
  #     api_base: "https://api.deepseek.com"
  #     api_key: "sk-c12dbed05da14d489f594d4c5fb81277" 

  # models:
